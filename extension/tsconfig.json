{
    "compilerOptions": {
        "module": "esnext",
        "moduleResolution": "bundler",
        "target": "ES2022",
        "lib": ["ESNext"],
        "types": ["node", "mocha"],
        "sourceMap": true,
        "paths": {
            "@generated/*": ["./generated/*"]
        },
        "noUncheckedIndexedAccess": true,
        "strict": true
    },
    "watchOptions": {
        "excludeDirectories": ["generated"]
    },
    "include": ["src", "generated"],
    "exclude": ["src/webview"]
}
