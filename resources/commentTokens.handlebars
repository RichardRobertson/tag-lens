<!DOCTYPE html>
<html lang="en">

<head>
    <script src="{{{script}}}" type="module" defer></script>
    <link rel="stylesheet" href="{{{stylesheet}}}">
    <link rel="stylesheet" href="{{{codicon}}}">
</head>

<body>
    <h1>Comment Tokens</h1>
    <form>
        <table>
            <thead>
                <tr>
                    <th></th>
                    <th>Source</th>
                    <th>Line Comment Start</th>
                    <th>Block Comment Start</th>
                    <th>Block Comment End</th>
                </tr>
            </thead>
            {{#each languages as |_ language|}}
            <tbody>
                <tr>
                    <th colspan="5">{{language}}</th>
                </tr>
                {{#if current}}
                <tr>
                    <td><input type="radio" name="{{language}}" value="current" checked></td>
                    <td><span class="codicon codicon-settings"></span>Current</td>
                    <td>
                        {{#if current.lineCommentStart}}
                        <code>{{current.lineCommentStart}}</code>
                        {{else}}
                        <span class="muted">(unset)</span>
                        {{/if}}
                    </td>
                    <td>
                        {{#if current.blockCommentStart}}
                        <code>{{current.blockCommentStart}}</code>
                        {{else}}
                        <span class="muted">(unset)</span>
                        {{/if}}
                    </td>
                    <td>
                        {{#if current.blockCommentEnd}}
                        <code>{{current.blockCommentEnd}}</code>
                        {{else}}
                        <span class="muted">(unset)</span>
                        {{/if}}
                    </td>
                </tr>
                {{/if}}
                {{#each discovered}}
                <tr>
                    <td><input type="radio" name="{{language}}" value="{{@key}}" {{#if (and (not current)
                            @first)}}checked{{/if}}></td>
                    <td><span class="codicon codicon-sparkle"></span>{{@key}}</td>
                    <td>
                        {{#if lineCommentStart}}
                        <code>{{lineCommentStart}}</code>
                        {{else}}
                        <span class="muted">(unset)</span>
                        {{/if}}
                    </td>
                    <td>
                        {{#if blockCommentStart}}
                        <code>{{blockCommentStart}}</code>
                        {{else}}
                        <span class="muted">(unset)</span>
                        {{/if}}
                    </td>
                    <td>
                        {{#if blockCommentEnd}}
                        <code>{{blockCommentEnd}}</code>
                        {{else}}
                        <span class="muted">(unset)</span>
                        {{/if}}
                    </td>
                </tr>
                {{/each}}
                <tr>
                    <td><input type="radio" name="{{language}}" value="custom"></td>
                    <td><span class="codicon codicon-pencil"></span>Custom</td>
                    <td><input placeholder="(unset)" type="text" name="{{language}}.lineCommentStart"></td>
                    <td><input placeholder="(unset)" type="text" name="{{language}}.blockCommentStart"></td>
                    <td><input placeholder="(unset)" type="text" name="{{language}}.blockCommentEnd"></td>
                </tr>
                <tr>
                    <td><input type="radio" name="{{language}}" value="remove"></td>
                    <td><span class="codicon codicon-trash"></span>Remove</td>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
            </tbody>
            {{/each}}
        </table>
        <p><button type="submit" id="apply">Apply</button></p>
    </form>
</body>

</html>
